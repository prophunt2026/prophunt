{
  "info": {
    "name": "PropHunter TN - AI Service",
    "description": "Collection complète pour tester le ai-service (port 3001) et via Gateway (port 3000).\nSources disponibles : tecnocasa, mubawab, tayara, tunisie_annonce, fi_dari",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "ai_url",      "value": "http://localhost:3001" },
    { "key": "gateway_url", "value": "http://localhost:3000/v1/service-ia" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check - AI Service direct",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3001/health", "host": ["localhost"], "port": "3001", "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('service = ai-service', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.service).to.eql('ai-service');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health Check - via Gateway",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/v1/service-ia/health", "host": ["localhost"], "port": "3000", "path": ["v1", "service-ia", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('service = ai-service', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tecnocasa",
      "item": [
        {
          "name": "POST - Lancer scraping tecnocasa",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:3001/scraping/tecnocasa", "host": ["localhost"], "port": "3001", "path": ["scraping", "tecnocasa"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('job_id present', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.job_id).to.be.a('string');",
                  "  pm.expect(json.source).to.eql('tecnocasa');",
                  "  pm.expect(json.status).to.eql('pending');",
                  "  pm.collectionVariables.set('tecnocasa_job_id', json.job_id);",
                  "  console.log('job_id:', json.job_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Status tecnocasa",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3001/scraping/tecnocasa/status", "host": ["localhost"], "port": "3001", "path": ["scraping", "tecnocasa", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('source = tecnocasa', () => pm.expect(json.source).to.eql('tecnocasa'));",
                  "console.log('Status:', json.status, '| Step:', json.step);",
                  "if (json.status === 'completed') console.log('Result:', JSON.stringify(json.result));",
                  "if (json.status === 'failed')    console.log('Error:', json.error);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Lancer scraping tecnocasa - via Gateway",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:3000/v1/service-ia/scraping/tecnocasa", "host": ["localhost"], "port": "3000", "path": ["v1", "service-ia", "scraping", "tecnocasa"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 ou 409', () => pm.expect([202, 409]).to.include(pm.response.code));",
                  "console.log(pm.response.code, pm.response.json());"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Status tecnocasa - via Gateway",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/v1/service-ia/scraping/tecnocasa/status", "host": ["localhost"], "port": "3000", "path": ["v1", "service-ia", "scraping", "tecnocasa", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "console.log('Status:', pm.response.json().status);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Double lancement tecnocasa (attend 409)",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:3001/scraping/tecnocasa", "host": ["localhost"], "port": "3001", "path": ["scraping", "tecnocasa"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "console.log('409 detail:', pm.response.json().detail);"
                ]
              }
            }
          ]
        }
      ]
    },
