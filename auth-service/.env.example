PORT=3003
MONGODB_URI=mongodb://localhost:27017/prophunter_auth

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_use_a_strong_random_secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_DAYS=7

# ─── Admin initial ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@prophunter.tn
ADMIN_PASSWORD=change_me
