    {
      "name": "3. Proprietes Publiques (CRUD - Sans Auth)",
      "item": [
        {
          "name": "3.1 Liste Paginee des Annonces (GET /properties)",
          "description": "Retourne toutes les annonces visibles au public (annonces scrapées + annonces utilisateurs acceptées par l'admin).",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/crud/properties?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "3.2 Recherche Multi-Criteres (/search)",
          "description": "Recherche combinée par ville, type de bien, fourchette de prix, type de transaction.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/crud/properties/search?ville=Tunis&type=Appartement&transaction=Vente&prixMin=100000&prixMax=600000",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties", "search"],
              "query": [
                { "key": "ville", "value": "Tunis" },
                { "key": "type", "value": "Appartement" },
                { "key": "transaction", "value": "Vente" },
                { "key": "prixMin", "value": "100000" },
                { "key": "prixMax", "value": "600000" }
              ]
            }
          }
        },
        {
          "name": "3.3 Detail d'une Annonce (GET /properties/:id)",
          "description": "Récupère les détails complets d'une annonce publique.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/crud/properties/{{user_property_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties", "{{user_property_id}}"]
            }
          }
        },
        {
          "name": "3.4 Filtrer par Source Specifique (GET /properties/source/:source)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/crud/properties/source/mubawab?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties", "source", "mubawab"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Annonces Utilisateurs — User CRUD (Auth Required)",
      "item": [
        {
          "name": "4.1 Publier une Annonce (POST /properties - avec Photos)",
          "description": "Crée une nouvelle annonce en 1 seul appel avec les données du formulaire et les fichiers images physiques attachés. Statut initial : 'pending'.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res._id) {",
                  "    pm.collectionVariables.set('user_property_id', res._id);",
                  "    console.log('user_property_id saved:', res._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "titre", "value": "Appartement S+2 Haut Standing La Marsa", "type": "text" },
                { "key": "texte", "value": "Superbe appartement avec terrasse vue dégagée, cuisine équipée...", "type": "text" },
                { "key": "type_transaction", "value": "Location", "type": "text" },
                { "key": "prix", "value": "1800", "type": "text" },
                { "key": "type_bien", "value": "Appartement", "type": "text" },
                { "key": "superficie_totale", "value": "115", "type": "text" },
                { "key": "nombre_pieces", "value": "3", "type": "text" },
                { "key": "nombre_chambres", "value": "2", "type": "text" },
                { "key": "nombre_salles_bain", "value": "1", "type": "text" },
                { "key": "ville", "value": "Tunis", "type": "text" },
                { "key": "delegation", "value": "La Marsa", "type": "text" },
                { "key": "nom_contact", "value": "Mohamed Ben Ali", "type": "text" },
                { "key": "images", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/crud/properties",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties"]
            }
          }
        },
        {
          "name": "4.2 Mes Annonces (GET /my-properties - Page Profil)",
          "description": "Retourne toutes les annonces de l'utilisateur connecté avec leurs photos et statuts ('pending', 'accepted', 'rejected').",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/properties/my-properties?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties", "my-properties"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "4.3 Modifier mon Annonce (PATCH /my-properties/:id - avec Photos)",
          "description": "Permet de modifier les détails et/ou les photos de l'annonce. Repasse automatiquement en 'pending' pour ré-approbation admin.",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "titre", "value": "Appartement S+2 Haut Standing La Marsa (Prix Négociable)", "type": "text" },
                { "key": "prix", "value": "1700", "type": "text" },
                { "key": "prix_negociable", "value": "true", "type": "text" },
                { "key": "images", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/crud/properties/my-properties/{{user_property_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties", "my-properties", "{{user_property_id}}"]
            }
          }
        },
        {
          "name": "4.4 Supprimer mon Annonce (DELETE /my-properties/:id)",
          "description": "Supprime définitivement une annonce appartenant à l'utilisateur.",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/properties/my-properties/{{user_property_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "properties", "my-properties", "{{user_property_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Moderation & Administration (Admin Only)",
      "item": [
        {
          "name": "5.1 Toutes les Annonces (GET /admin/properties)",
          "description": "Liste toutes les annonces de la plateforme pour l'administration.",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/admin/properties?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "admin", "properties"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "5.2 Annonces en Attente de Validation (status=pending)",
          "description": "Filtre les annonces créées ou modifiées par les utilisateurs en attente d'approbation.",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/admin/properties?status=pending&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "admin", "properties"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "5.3 Annonces Acceptees (status=accepted)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/admin/properties?status=accepted&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "admin", "properties"],
              "query": [
                { "key": "status", "value": "accepted" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "5.4 Annonces Rejetees (status=rejected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/admin/properties?status=rejected&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "admin", "properties"],
              "query": [
                { "key": "status", "value": "rejected" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "5.5 Filtrer par Site de Scraping (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/admin/properties?scraping=true&site=tayara&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "admin", "properties"],
              "query": [
                { "key": "scraping", "value": "true" },
                { "key": "site", "value": "tayara" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "5.6 Filtrer par Periode de Scraping (Admin)",
          "description": "Filtre par date de scraping avec prise en compte de la fin de journée à 23:59:59.999Z.",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/crud/admin/properties?startDate=2026-08-01&endDate=2026-08-20&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["crud", "admin", "properties"],
              "query": [
                { "key": "startDate", "value": "2026-08-01" },
                { "key": "endDate", "value": "2026-08-20" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "5.7 Approuver une Annonce (PATCH status=accepted)",
