{
  "info": {
    "name": "PropHunter TN - Complete API Collection (All Services)",
    "description": "Collection complète de tests pour l'intégralité du backend PropHunter TN via API Gateway (Port 3000).\n\nOrganisation complète des 6 dossiers :\n1. Authentification & Profil (User & Admin)\n2. AI Service & Scraping Parallèle (Admin Only)\n3. Propriétés Publiques & Recherche (Sans Auth)\n4. Annonces Utilisateurs — User CRUD (Auth Required)\n5. Modération & Administration Annonces (Admin Only)\n6. Métadonnées Scraping & Statistiques (Admin Only)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/v1" },
    { "key": "user_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "user_property_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentification & Profil",
      "item": [
        {
          "name": "1.1 Inscription Utilisateur (Signup)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user_demo@test.tn\",\n  \"password\": \"Pass@1234!\",\n  \"nom\": \"Mohamed Ben Ali\",\n  \"telephone\": \"+216 55 123 456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "1.2 Connexion Utilisateur (Signin) -> Auto-Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('user_token', res.access_token);",
                  "    console.log('user_token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user_demo@test.tn\",\n  \"password\": \"Pass@1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signin"]
            }
          }
        },
        {
          "name": "1.3 Connexion Admin (Signin) -> Auto-Save Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('admin_token', res.access_token);",
                  "    console.log('admin_token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@prophunter.tn\",\n  \"password\": \"Admin@PropHunter2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signin"]
            }
          }
        },
        {
          "name": "1.4 Consulter son Profil (GET /profile)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "1.5 Mettre a jour son Profil (PATCH /profile)",
          "description": "Permet à l'utilisateur de modifier son nom et/ou son numéro de téléphone.",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Mohamed Ben Ali Modifié\",\n  \"telephone\": \"+216 99 888 777\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "1.6 Uploader son Avatar (POST /profile/avatar)",
          "description": "Upload de la photo de profil en form-data. Retourne l'URL complète exploitable directement par le frontend.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "avatar", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile", "avatar"]
            }
          }
        },
        {
          "name": "1.7 Supprimer Definitivement son Compte (DELETE /profile)",
          "description": "Hard Delete : supprime définitivement l'utilisateur de MongoDB, son avatar sur disque, et supprime en cascade toutes ses annonces et photos dans crud-service.",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "1.8 Rafraichir le Token (Refresh)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"<COLLEZ_VOTRE_REFRESH_TOKEN_ICI>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        }
      ]
    },
